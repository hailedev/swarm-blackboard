# Copy to .env — never commit the real file.

# Anthropic API key from the Anthropic Console (separate from a Claude.ai subscription).
ANTHROPIC_API_KEY=

# Ollama server backing the local worker roles. Use the Mac mini's address when running
# the app from another machine, e.g. http://mac-mini.local:11434
OLLAMA_BASE_URL=http://localhost:11434

# SQLite database file for runs, entries, events and model-call traces. The CLI, the
# server and `pnpm test:llm` all write this one file; it is also the monthly spend ledger.
DATABASE_URL=file:./data/team.db

# Port the API server listens on (`pnpm dev`).
PORT=3001

# Monthly API spend limit enforced by the app (docs/budget-guardrails.md §3). Paid runs are
# refused when the month cannot absorb their cap and paused when the month is spent. Set the
# same figure as a spend limit in the Anthropic Console: that is the backstop for this one.
MONTHLY_BUDGET_USD=5.00

# IANA time zone whose calendar months bound the monthly budget.
BUDGET_TIMEZONE=Australia/Sydney
