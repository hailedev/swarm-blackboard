# Copy to .env — never commit the real file.

# Anthropic API key from the Anthropic Console (separate from a Claude.ai subscription).
ANTHROPIC_API_KEY=

# Ollama server backing the local worker roles. Use the Mac mini's address when running
# the app from another machine, e.g. http://mac-mini.local:11434
OLLAMA_BASE_URL=http://localhost:11434

# SQLite database file for runs, entries, events and model-call traces.
DATABASE_URL=file:./data/team.db
