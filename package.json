{
  "name": "swarm-blackboard",
  "version": "0.0.0",
  "private": true,
  "description": "Team — a blackboard swarm of LLM agents collaborating on open-ended problems",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json && pnpm -r run typecheck",
    "dev": "pnpm run \"/^serve:/\"",
    "serve:api": "tsx watch apps/server/src/index.ts",
    "serve:web": "pnpm --filter @team/web dev",
    "dev:fake": "pnpm run \"/^fake:/\"",
    "fake:api": "tsx watch apps/server/src/index.ts --fake",
    "fake:web": "pnpm --filter @team/web dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:llm": "vitest run --mode llm",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm --filter @team/web test:e2e",
    "solve": "tsx apps/cli/src/solve.ts",
    "db:generate": "pnpm --filter @team/host db:generate",
    "ledger:import": "tsx apps/cli/src/import-ledger.ts",
    "trial:local": "tsx apps/cli/src/trial.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
